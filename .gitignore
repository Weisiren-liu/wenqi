# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller
build/
dist/
*.spec

# Virtual environments
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test files
*.docx
!test/*.docx

# Logs
*.log

# 用户的本地自定义设置不应再被提交
# 出厂默认值定义在代码里，开发者本地的修改不应进版本控制
custom_settings.json

# AI API Key 本地配置，包含敏感信息
ai_settings.json
ai_glossary.txt

# macOS 资源分叉文件
._*

# P2 GUI 自检的截图产物（prototype/_check_p2_gui.py 运行时生成）
prototype/_p2_shots/

# P3 窄屏自检截图与端到端回归产物（运行时生成，不入库）
prototype/_p3_shots/
prototype/_e2e_out/
prototype/_e2e_wt/

# Local caches and credentials
.pytest_cache/
.env
.env.*
*.pem
*.key
*.p12
